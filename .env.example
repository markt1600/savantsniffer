# Copy to .env and fill in as you discover things. .env is git-ignored.

# --- Lutron processor ---
LUTRON_HOST=
# telnet (LIP) systems: HomeWorks QS / RadioRA 2
LUTRON_LIP_PORT=23
LUTRON_LIP_USER=lutron
LUTRON_LIP_PASSWORD=integration

# LEAP systems: HomeWorks QSX / RadioRA 3 / Caseta
LUTRON_LEAP_PORT=8081
LUTRON_LEAP_KEYFILE=caseta.key
LUTRON_LEAP_CERTFILE=caseta.crt
LUTRON_LEAP_CA=caseta-bridge.crt

# --- Savant host (Mac mini) ---
SAVANT_HOST=

# --- Your LAN (filled by discovery, e.g. 192.168.1.0/24) ---
LAN_SUBNET=
